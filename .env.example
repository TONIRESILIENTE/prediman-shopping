# Banco de Dados
DATABASE_URL=postgresql://prediman_user:sua_senha_segura_aqui@db:5432/prediman_db

# Segurança JWT
SECRET_KEY=sua-chave-super-secreta-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DB_PASSWORD=sua_senha_segura

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883

# Admin padrão
ADMIN_EMAIL=admin@prediman.com
ADMIN_PASSWORD=Admin123!